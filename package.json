{
  "name": "toshkent-3d",
  "private": true,
  "version": "0.1.0",
  "description": "Browser 3D model of the whole city of Tashkent, built from OpenStreetMap data with three.js. Walk the streets or fly over the city.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diy0r/tashkent-3d.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --port 5190 --strictPort",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "preview": "vite preview --port 5190 --strictPort",
    "fixture": "node scripts/make-dev-tiles.mjs",
    "build:prod": "vite build && node tools/compress.mjs",
    "serve": "node server/serve.mjs",
    "build-data": "npm --prefix pipeline run build-data",
    "tag-landmarks": "npm --prefix pipeline run tag-landmarks"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "earcut": "^3.2.4",
    "lucide-react": "^1.76.0",
    "next-themes": "^0.4.6",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "three": "^0.187.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/earcut": "^3.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
